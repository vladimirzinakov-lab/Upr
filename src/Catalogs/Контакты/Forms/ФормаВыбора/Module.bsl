
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Оповестить("Выбран контакт", ВыбраннаяСтрока);
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Контакт = Справочники.Контакты.НайтиПоНаименованию(Параметры.Строка_Контакт);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.Список.ТекущаяСтрока = Параметры.Контакт;
	
КонецПроцедуры
