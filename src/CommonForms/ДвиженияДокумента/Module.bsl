////////////////////////////////////////////////////////////////////////////////
// Форма просмотра движений документа по регистрам накопления.
// Открывается из формы документа с параметром Документ.
// Параметры формы:
//  Документ - документ, движения которого необходимо показать.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.Документ) Тогда
		ЗаполнитьДвижения(Параметры.Документ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДвижения(Документ)
	
	Движения.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	""Касса"" КАК ИмяРегистра,
		|	КассаРегистр.Период КАК Период,
		|	КассаРегистр.ВидДвижения КАК ВидДвижения,
		|	КассаРегистр.Касса КАК Аналитика,
		|	КассаРегистр.Сумма КАК Сумма
		|ИЗ
		|	РегистрНакопления.Касса КАК КассаРегистр
		|ГДЕ
		|	КассаРегистр.Регистратор = &Регистратор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Банк"",
		|	Банк.Период,
		|	Банк.ВидДвижения,
		|	Банк.Счет,
		|	Банк.Сумма
		|ИЗ
		|	РегистрНакопления.Банк КАК Банк
		|ГДЕ
		|	Банк.Регистратор = &Регистратор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Доходы"",
		|	Доходы.Период,
		|	""Оборот"",
		|	Доходы.Статья,
		|	Доходы.Сумма
		|ИЗ
		|	РегистрНакопления.Доходы КАК Доходы
		|ГДЕ
		|	Доходы.Регистратор = &Регистратор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Расходы"",
		|	Расходы.Период,
		|	""Оборот"",
		|	Расходы.Статья,
		|	Расходы.Сумма
		|ИЗ
		|	РегистрНакопления.Расходы КАК Расходы
		|ГДЕ
		|	Расходы.Регистратор = &Регистратор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""Покупатели"",
		|	Покупатели.Период,
		|	Покупатели.ВидДвижения,
		|	Покупатели.Контрагент,
		|	Покупатели.Сумма
		|ИЗ
		|	РегистрНакопления.Покупатели КАК Покупатели
		|ГДЕ
		|	Покупатели.Регистратор = &Регистратор";
	
	Запрос.УстановитьПараметр("Регистратор", Документ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Движения.Добавить();
		НоваяСтрока.ИмяРегистра = Выборка.ИмяРегистра;
		НоваяСтрока.Период = Выборка.Период;
		НоваяСтрока.ВидДвижения = Строка(Выборка.ВидДвижения);
		НоваяСтрока.Аналитика = Выборка.Аналитика;
		НоваяСтрока.Сумма = Выборка.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
