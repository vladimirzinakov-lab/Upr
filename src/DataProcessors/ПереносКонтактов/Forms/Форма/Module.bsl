#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПеренос(Команда)
	
	ВыполнитьПереносНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьПереносНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Реализация.Ссылка КАК Ссылка,
		|	Реализация.НовыйКонтакт КАК НовыйКонтакт
		|ИЗ
		|	Документ.Реализация КАК Реализация
		|ГДЕ
		|	НЕ Реализация.ПометкаУдаления
		|	И НЕ Реализация.НовыйКонтакт = """"
		|	И Реализация.Контакт = ЗНАЧЕНИЕ(Справочник.Контакты.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоПеренесено = 0;
	КоличествоНеНайдено = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Контакт = Справочники.Контакты.НайтиПоНаименованию(Выборка.НовыйКонтакт);
		
		Если НЕ ЗначениеЗаполнено(Контакт) Тогда
			КоличествоНеНайдено = КоличествоНеНайдено + 1;
			Продолжить;
		КонецЕсли;
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДокументОбъект.Контакт = Контакт;
		ДокументОбъект.Записать();
		
		КоличествоПеренесено = КоличествоПеренесено + 1;
		
	КонецЦикла;
	
	ТекстСообщения = СтрШаблон(
		"Перенесено документов: %1, контакт не найден: %2.",
		КоличествоПеренесено, КоличествоНеНайдено);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
